{
  "name": "tech-recruiting-tracker",
  "version": "1.0.0",
  "description": "End-to-end app for the job search: scraped job feed, application tracker, and networking/hiring-manager finder.",
  "main": "index.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:worker": "wrangler dev --port 8787",
    "postinstall": "npm --prefix frontend ci",
    "build": "npm --prefix frontend run build",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:actor": "npm --prefix apify/company-careers test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
